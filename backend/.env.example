# Application Settings
PROJECT_NAME="BookTicket Movie Booking API"
VERSION="1.0.0"
SECRET_KEY="replace_with_your_own_jwt_secret_key_in_production"

# Database Server Configurations
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="movieticket_db"

# Expiration policies & Security
SEAT_LOCK_EXPIRATION_MINUTES=5
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Development Settings
# Set DEBUG=false in production environments
DEBUG=true

# CORS origins (comma-separated for multiple origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Note: Replace MONGO_URI with your MongoDB Atlas connection string for production.
